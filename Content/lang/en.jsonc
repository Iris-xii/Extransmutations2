{
  "extransmutations2": {
    "": "Extransmutations",
    "description": "A collection of extra Opus Magnum Glyphs, or Extra Transmutations, or Extransmutations, if you will. These are so far mostly concerned with cardinals and are meant to be used in puzzles without berlo/duplication.",
    "atoms": {
      "test_atom": {
        "": "Test Atom",
        "elemental": "Elemental Test Atom"
      }
    },
    "permission_sections": {
      "extransmutations-section":"Extransmutations"
    },
    "permissions": {
      "cardinal-revolution-line":"Leyline of Card. Revolution",
      "cardinal-revolution-tri":"Triad of Card. Revolution",
      "cardinal-inversion":"Glyph of Card. Inversion",
      "cardinal-completion":"Glyph of Card. Completion",
      "aeration":"Glyph of Aeration",
      "induction":"Glyph of Induction",
      "compaction":"Glyph of Compaction"
    },
    "parts":{
      "cardinal-revolution-line": {
        "":"Leyline of Cardinal Revolution",
        "description":"The Leyline of Cardinal Revolution transmutes three matching atoms of the same cardinal into two salt atoms, and the next cardinal in the sequence Air -> Water -> Earth -> Fire -> Air (Clockwise along the chart of alchemical primes)"
      },
      "cardinal-revolution-tri": {
        "":"Triad of Cardinal Revolution",
        "description":"The Triad of Cardinal Revolution transmutes three matching atoms of the same cardinal into two salt atoms, and the next cardinal in the sequence Air -> Water -> Earth -> Fire -> Air (Clockwise along the chart of alchemical primes)"
      },
      "cardinal-inversion": {
        "":"Glyph of Cardinal Inversion",
        "description":"The glyph of cardinal inversion transmutes two matching cardinals into an opposing cardinal and salt."
      },
      "cardinal-completion": {
        "":"Glyph of Cardinal Completion",
        "description":"The Glyph of Cardinal Completion transmutes 3 different cardinals and 1 salt atom into 4 atoms of the missing cardinal. Berlo's Wheel may be placed over the bowls to mediate in the use of the glyph, fulfilling the requirement of said bowls without it itself being transmuted."
      },
      "aeration": {
        "":"Glyph of Aeration",
        "description":"The Glyph of Aeration turns an atom of salt into Air."
      },
      "induction": {
        "":"Glyph of Induction",
        "description":"The Glyph of Induction can attach its hollow hex to another glyph. Whenever a transmutation takes place in the attached hex, the glyph of induction will transmute an atom of salt into fire. It is not permitted to attach multiple induction hooks to the same hex, or to attach it to another glyph of induction."
      },
      "compaction": {
        "":"Glyph of Compaction",
        "description":"The Glyph of Compaction transmutes an atom of salt into an atom of Earth if it has 3 or more bonds. A full triplex counts as three bonds."
      }
    }
  }
}